# Compose-level variables (docker-compose.yml). Copy to .env before running
# `docker compose up`:
#
#   cp .env.example .env
#
# Secrets that only the backend process itself needs (JWT_SECRET) stay in
# backend/.env, not here — this file is only for values docker-compose.yml
# itself interpolates.

POSTGRES_USER=dofixo
POSTGRES_PASSWORD=dofixo
POSTGRES_DB=dofixo_dev
POSTGRES_PORT=5432

BACKEND_PORT=5001
FRONTEND_PORT=5173