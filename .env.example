# Variables consumed by docker-compose.yml (local development only).
#
# Copying this to .env is optional: docker-compose.yml falls back to these
# same values, so `docker compose up -d` works with no .env present. Copy it
# when you need to override something, e.g. POSTGRES_PORT if 5432 is taken.
#
#   cp .env.example .env
#
# Application variables live in backend/.env — see backend/.env.example.

POSTGRES_USER=dofixo
POSTGRES_PASSWORD=dofixo
POSTGRES_DB=dofixo_dev

# Host port the container's 5432 is published on.
POSTGRES_PORT=5432
