# Production environment for docker-compose.prod.yml. Copy to .env.prod on
# the server and fill in. Never committed — .env.prod must be in .gitignore.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

APP_DOMAIN=app.dofixo.ir
# Where Let's Encrypt sends expiry warnings. A real address you read.
ACME_EMAIL=

# Database owner. Used by migrations and seed only, never by the API.
POSTGRES_USER=dofixo
POSTGRES_DB=dofixo
POSTGRES_PASSWORD=

# The role the API connects as. Owns no tables, so it cannot bypass RLS.
# Created by the migration without a password; set one after the first
# `migrate` run:
#   docker compose -f docker-compose.prod.yml exec postgres \
#     psql -U dofixo -d dofixo -c "ALTER ROLE dofixo_app WITH LOGIN PASSWORD '...';"
POSTGRES_APP_PASSWORD=

# No default anywhere: middleware/auth.ts refuses to load without it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Production needs its own bucket and keys. reza-app-test-1 is a test bucket.
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_REGION=default
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# sms.ir. Sandbox and production have different keys AND template ids.
# The server's IP must be on the panel's allowlist, or every send returns
# HTTP 401 that reads in the logs exactly like a bad key.
SMS_API_KEY=
SMS_TEMPLATE_ID=

# 0 disables a limit. Never 0 here.
RATE_LIMIT_API=1000
RATE_LIMIT_LOGIN=10
RATE_LIMIT_OTP=3