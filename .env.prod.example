# Production environment for docker-compose.prod.yml. Copy to .env.prod on
# the server and fill in. Never committed — .env.prod must be in .gitignore.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

APP_DOMAIN=app.dofixo.ir
# Directory holding fullchain.pem and privatekey.pem, mounted read-only into
# Caddy. Outside the repository on purpose.
TLS_CERT_DIR=/home/reza/certs

# Database owner. Used by migrations and seed only, never by the API.
POSTGRES_USER=dofixo
POSTGRES_DB=dofixo
POSTGRES_PASSWORD=

# The role the API connects as. Owns no tables, so it cannot bypass RLS.
# Created by the migration without a password; set one after the first
# `migrate` run:
#   docker compose -f docker-compose.prod.yml exec postgres \
#     psql -U dofixo -d dofixo -c "ALTER ROLE dofixo_app WITH LOGIN PASSWORD '...';"
POSTGRES_APP_PASSWORD=

# No default anywhere: middleware/auth.ts refuses to load without it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Production needs its own bucket and keys. reza-app-test-1 is a test bucket.
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_REGION=default
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# sms.ir. Sandbox and production have different keys AND template ids.
# The server's IP must be on the panel's allowlist, or every send returns
# HTTP 401 that reads in the logs exactly like a bad key.
SMS_API_KEY=
SMS_TEMPLATE_ID=

# Every template id in SMS_TEMPLATES is resolved at import, so a missing one
# stops the container at boot rather than on the night the cron first needs
# it. These five are Dofixo's own messages (8.7) and Dofixo pays for them.
SMS_TEMPLATE_BEFORE_EXPIRY=
SMS_TEMPLATE_ON_EXPIRY=
SMS_TEMPLATE_AFTER_EXPIRY=
SMS_TEMPLATE_PAYMENT_OK=
SMS_TEMPLATE_REFERRAL_REWARD=

# The three a workshop sends to its own customers (12.5), charged to that
# workshop's SMS wallet rather than to us.
SMS_TEMPLATE_DEVICE_ACCEPTED=
SMS_TEMPLATE_DEVICE_READY=
SMS_TEMPLATE_DEVICE_DELIVERED=

# Zibal (8.5). lib/zibal reads both at import and refuses to start without
# them, and refuses to start in production if the merchant is still Zibal's
# shared test account. APP_URL is what both payment callbacks are built from.
ZIBAL_MERCHANT=
APP_URL=https://app.dofixo.ir

# 0 disables a limit. Never 0 here.
RATE_LIMIT_API=1000
RATE_LIMIT_LOGIN=10
RATE_LIMIT_OTP=3