{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	# /api goes to Express, everything else to the static bundle. The
	# routing lives here and only here: nginx inside the frontend image
	# deliberately knows nothing about the API, so a request that lands in
	# the wrong place has one file to check rather than two.
	handle /api/* {
		reverse_proxy backend:5001
	}

	handle {
		reverse_proxy frontend:8080
	}

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
