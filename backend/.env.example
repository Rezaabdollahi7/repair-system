# Backend application environment.
# Loaded by dotenv from backend/.env (see src/server.ts), so copy this file
# into place before running the API:
#
#   cp .env.example .env

# Owner connection: full privileges, bypasses Row-Level Security. Used by
# prisma.config.ts for migrations and by prisma/seed.ts — both of which have
# to see and change every workspace. The running API does NOT use this; see
# DATABASE_URL_APP below.
#
# 127.0.0.1 rather than localhost: on systems that resolve localhost to ::1
# first, Prisma fails with P1001 even though the container's port is
# published on both stacks.
DATABASE_URL=postgresql://dofixo:dofixo@127.0.0.1:5432/dofixo_dev?schema=public

# Connection the running API uses (src/lib/prisma.ts). Points at dofixo_app,
# a role that owns no tables and therefore cannot bypass the RLS policies
# from roadmap 2.3 — a table's owner ignores them, which would make every
# policy inert. There is deliberately no fallback to DATABASE_URL: falling
# back would silently restore a superuser connection and nothing would look
# wrong until one workspace read another's rows.
#
# The role is created by the migration without a password. Set one out of
# band, then put it here:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#   docker compose exec postgres psql -U dofixo -d dofixo_dev \
#     -c "ALTER ROLE dofixo_app WITH LOGIN PASSWORD '<password>';"
DATABASE_URL_APP=postgresql://dofixo_app:<رمز>@127.0.0.1:5432/dofixo_dev?schema=public

# Integration tests (pnpm test:integration) run against a separate database
# so a test run can never truncate development data. Same cluster, same
# roles — only the database differs. Both must end in "_test"; the setup
# refuses to run otherwise.
TEST_DATABASE_URL=postgresql://dofixo:dofixo@127.0.0.1:5432/dofixo_test?schema=public
TEST_DATABASE_URL_APP=postgresql://dofixo_app:zbvsKUnb48arNMqvRH2OcMIH9Ye6hdcL@127.0.0.1:5432/dofixo_test?schema=public

# Port the Express server listens on (defaults to 5001 if unset).
PORT=5001

# Secret used to sign JWTs. src/middleware/auth.js falls back to a hardcoded
# placeholder when this is missing — that fallback is for local dev only and
# must never be relied on outside it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Set to 1 in production (behind Nginx/Caddy) so express-rate-limit reads the
# real client IP from X-Forwarded-For instead of the proxy's IP — otherwise
# every user shares one rate-limit bucket. Set to 0 in local dev, where
# there's no reverse proxy and trusting X-Forwarded-For would let a client
# spoof its own IP to dodge the limit.
TRUST_PROXY=0

# Initial password for the seeded "superadmin" account (prisma/seed.ts).
# Not hardcoded in the seed script so the repo never carries a working
# credential. Change the password from the UI after first login. Generate
# one with:
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
SEED_ADMIN_PASSWORD=

# Requests allowed per 15 minutes, per IP. 0 disables the limit — useful
# while testing locally, never in production.
RATE_LIMIT_API=1000
RATE_LIMIT_LOGIN=10

# Username of the seeded super admin. The username is a phone number now, so
# "superadmin" no longer satisfies the login schema. Use a number you can
# actually remember — it is how you sign in to the development database.
SEED_ADMIN_USERNAME=09120000000