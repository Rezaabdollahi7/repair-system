// Modeled on the existing SQLite schema in the pre-migration codebase — same
// entities and shape, not a redesign (see CLAUDE.md), with workspaceId added
// on top in phase 2.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums are used only where the value set is provably closed: the CHECK
// constraint the old SQLite schema already had, and the validStatuses array
// in repairInvoiceController.

enum InventoryTransactionType {
  purchase
  sale
  adjustment

  @@map("inventory_transaction_type")
}

enum RepairInvoiceStatus {
  draft
  issued
  paid
  cancelled

  @@map("repair_invoice_status")
}

enum WorkspaceStatus {
  trial
  active
  expired

  @@map("workspace_status")
}

enum OtpPurpose {
  register
  reset

  @@map("otp_purpose")
}

// ── Tenancy ──────────────────────────────────────────────────

// A repair shop. No slug: the app is served from one shared domain, so a
// workspace is only ever identified by the id carried in the caller's token.
model Workspace {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

// One expiresAt covers both the trial and a paid period: the question
  // asked of it is always "may this workspace still be written to".
  status    WorkspaceStatus @default(trial)
  expiresAt DateTime?       @map("expires_at")

  // Invoice numbering, one counter per kind. Held here rather than derived
  // from COUNT(*): counting reads a value two concurrent requests can both
  // see, while `seq = seq + 1` takes a row lock and hands each caller a
  // different number. Incremented inside the invoice's own transaction, so a
  // rollback returns the number rather than leaving a gap in the books.
  purchaseSeq Int @default(0) @map("purchase_seq")
  saleSeq     Int @default(0) @map("sale_seq")
  repairSeq   Int @default(0) @map("repair_seq")

  users                 User[]
  customers             Customer[]
  devices               Device[]
  deviceImages          DeviceImage[]
  deviceAssignments     DeviceAssignment[]
  categories            Category[]
  items                 Item[]
  inventoryTransactions InventoryTransaction[]
  purchaseInvoices      PurchaseInvoice[]
  purchaseInvoiceItems  PurchaseInvoiceItem[]
  saleInvoices          SaleInvoice[]
  saleInvoiceItems      SaleInvoiceItem[]
  services              Service[]
  repairInvoices        RepairInvoice[]
  repairInvoiceItems    RepairInvoiceItem[]
  repairInvoicePayments RepairInvoicePayment[]
  settings              Settings?
  backups               Backup[]
  refreshTokens         RefreshToken[]

  @@index([status])
  @@map("workspaces")
}

// ── Auth & people ────────────────────────────────────────────

// Not tenant-scoped: the three roles are reference data shared by every
// workspace, not something a shop owns or can change.
model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

model User {
  id          Int      @id @default(autoincrement())
  workspaceId Int      @map("workspace_id")
  fullName    String   @map("full_name")
  // Globally unique, not per workspace: the username is a phone number, and
  // one person's number identifies one account across the platform.
  username    String   @unique
  password    String
  phone       String?
  avatar      String?
  roleId      Int      @map("role_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  devicesAssigned        Device[]               @relation("DeviceTechnician")
  assignmentsReceived    DeviceAssignment[]     @relation("AssignmentTechnician")
  assignmentsMade        DeviceAssignment[]     @relation("AssignmentAuthor")
  inventoryTransactions  InventoryTransaction[]
  purchaseInvoices       PurchaseInvoice[]
  saleInvoices           SaleInvoice[]
  repairInvoicesCreated  RepairInvoice[]        @relation("RepairInvoiceAuthor")
  repairInvoicesAssigned RepairInvoice[]        @relation("RepairInvoiceTechnician")
  repairInvoicePayments  RepairInvoicePayment[]
  backups                Backup[]
  refreshTokens          RefreshToken[]

  @@index([workspaceId])
  @@index([roleId])
  @@map("users")
}

// Long-lived, revocable sessions. Separate from the access token because a
// JWT cannot be taken back once issued: logging out, or noticing a stolen
// session, has to change something the server checks.
model RefreshToken {
  id          Int       @id @default(autoincrement())
  workspaceId Int       @map("workspace_id")
  userId      Int       @map("user_id")
  // SHA-256 of the token, never the token itself. A leaked database dump
  // then contains nothing that can be replayed. Not bcrypt: this is a
  // 32-byte random secret, not a human password, so there is no dictionary
  // to defend against — and bcrypt would slow every single refresh.
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  // Kept rather than deleted on rotation: a revoked row being presented
  // again is how a stolen token announces itself.
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  // Serves both "revoke every session this user has" and the expiry sweep.
  @@index([userId])
  @@map("refresh_tokens")
}

// ── Phone verification ───────────────────────────────────────

// The only table in the schema without a workspaceId, and deliberately so:
// a code is sent to a phone number before any workspace exists, so there is
// nothing to scope it by. It holds no tenant data — a phone number, a hash,
// an expiry and two counters. It carries a `USING (true)` policy rather than
// no RLS, so prisma/rls-check.sql reads it as intentional (see part 1b there).
model OtpCode {
  id      Int        @id @default(autoincrement())
  phone   String
  // Required, because the two purposes have opposite preconditions: for
  // `register` the phone must NOT already exist, for `reset` it must. A
  // single-purpose code would let one flow's message be spent on the other.
  purpose OtpPurpose

  // SHA-256 of the five-digit code.
  //
  // Be clear about what this does and does not buy: five digits is a hundred
  // thousand possibilities and the hash is unsalted, so anyone holding a
  // database dump can build the whole rainbow table in seconds. It is not
  // what makes this safe. The actual defences are the three-minute lifetime,
  // the three-attempt ceiling, and single use — do not remove any of them on
  // the reasoning that the column is hashed.
  //
  // Not unique, unlike refresh_tokens.token_hash: two people can legitimately
  // be sent the same five digits, and lookup is by phone + purpose anyway.
  codeHash String @map("code_hash")

  expiresAt DateTime @map("expires_at")
  // Burns the row at three. Checked alongside expiry and consumption, so a
  // code that ran out of attempts is dead even while it is still in date.
  attempts  Int      @default(0)
  // Set when the code is spent, and also when a newer code supersedes it:
  // re-sending invalidates whatever came before, so only ever one live code
  // exists per phone and purpose.
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  // Finds the live code for a phone, and — with phone as the leading column —
  // also serves the hourly send count.
  @@index([phone, purpose, createdAt(sort: Desc)])
  // For the sweep. Rows are removed by age, NOT by expiry: a code expires
  // after three minutes but has to keep counting against the hourly send
  // limit for an hour. Sweeping on expires_at would silently disable that
  // limit while looking like ordinary housekeeping.
  @@index([createdAt])
  @@map("otp_codes")
}

// ── Customers & devices ──────────────────────────────────────

model Customer {
  id          Int      @id @default(autoincrement())
  workspaceId Int      @map("workspace_id")
  name        String
  phone       String?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  devices        Device[]
  saleInvoices   SaleInvoice[]
  repairInvoices RepairInvoice[]

  // Leads with workspaceId so the index serves the scoped query the
  // application always issues.
  @@index([workspaceId, name])
  @@index([workspaceId, phone])
  @@map("customers")
}

model Device {
  id           Int       @id @default(autoincrement())
  workspaceId  Int       @map("workspace_id")
  customerId   Int?      @map("customer_id")
  personnelId  Int?      @map("personnel_id")
  deviceName   String    @map("device_name")
  brand        String?
  model        String?
  serialNumber String?   @map("serial_number")
  entryDate    DateTime? @map("entry_date")
  exitDate     DateTime? @map("exit_date")
  status       String    @default("received")
  description  String?
  needsInvoice Boolean   @default(true) @map("needs_invoice")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // SetNull rather than Cascade: a repair history should survive deleting
  // the customer or the technician who handled it.
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  personnel User?     @relation("DeviceTechnician", fields: [personnelId], references: [id], onDelete: SetNull)

  images         DeviceImage[]
  assignments    DeviceAssignment[]
  repairInvoices RepairInvoice[]
  saleInvoices   SaleInvoice[]

  @@index([workspaceId, id(sort: Desc)])
  @@index([workspaceId, status])
  @@index([workspaceId, entryDate])
  @@index([customerId])
  @@index([personnelId])
  @@map("devices")
}

model DeviceImage {
  id          Int      @id @default(autoincrement())
  workspaceId Int      @map("workspace_id")
  deviceId    Int      @map("device_id")
  filename    String
  filepath    String
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([deviceId])
  @@map("device_images")
}

model DeviceAssignment {
  id          Int      @id @default(autoincrement())
  workspaceId Int      @map("workspace_id")
  deviceId    Int      @map("device_id")
  personnelId Int      @map("personnel_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")
  assignedBy  Int?     @map("assigned_by")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  personnel User      @relation("AssignmentTechnician", fields: [personnelId], references: [id], onDelete: Cascade)
  author    User?     @relation("AssignmentAuthor", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([deviceId, personnelId])
  @@index([workspaceId])
  @@index([personnelId])
  @@map("device_assignments")
}

// ── Inventory ────────────────────────────────────────────────

model Category {
  id          Int      @id @default(autoincrement())
  workspaceId Int      @map("workspace_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  items Item[]

  // Unique within a workspace rather than globally: one shop naming a
  // category shouldn't stop every other shop from using that name.
  @@unique([workspaceId, name])
  @@map("categories")
}

model Item {
  id               Int      @id @default(autoincrement())
  workspaceId      Int      @map("workspace_id")
  categoryId       Int?     @map("category_id")
  name             String
  code             String?
  unit             String   @default("عدد")
  minStock         Int      @default(0) @map("min_stock")
  currentStock     Int      @default(0) @map("current_stock")
  avgPurchasePrice Decimal  @default(0) @map("avg_purchase_price") @db.Decimal(18, 2)
  sellPrice        Decimal  @default(0) @map("sell_price") @db.Decimal(18, 0)
  description      String?
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  transactions         InventoryTransaction[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  saleInvoiceItems     SaleInvoiceItem[]

  @@unique([workspaceId, code])
  @@index([workspaceId, code])
  @@index([workspaceId, name])
  @@index([categoryId])
  @@map("items")
}

model InventoryTransaction {
  id            Int                      @id @default(autoincrement())
  workspaceId   Int                      @map("workspace_id")
  itemId        Int                      @map("item_id")
  type          InventoryTransactionType
  quantity      Int
  unitPrice     Decimal                  @default(0) @map("unit_price") @db.Decimal(18, 0)
  // Polymorphic pointer (referenceType says which table), so no FK.
  referenceId   Int?                     @map("reference_id")
  referenceType String?                  @map("reference_type")
  note          String?
  createdBy     Int?                     @map("created_by")
  createdAt     DateTime                 @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([itemId])
  @@index([createdBy])
  @@map("inventory_transactions")
}

// ── Purchase invoices ────────────────────────────────────────

model PurchaseInvoice {
  id            Int      @id @default(autoincrement())
  workspaceId   Int      @map("workspace_id")
  invoiceNumber String   @map("invoice_number")
  supplierName  String?  @map("supplier_name")
  invoiceDate   DateTime @default(now()) @map("invoice_date")
  totalAmount   Decimal  @default(0) @map("total_amount") @db.Decimal(18, 0)
  paidAmount    Decimal  @default(0) @map("paid_amount") @db.Decimal(18, 0)
  paymentStatus String   @default("pending") @map("payment_status")
  note          String?
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  items PurchaseInvoiceItem[]

  @@unique([workspaceId, invoiceNumber])
  @@index([workspaceId, invoiceDate(sort: Desc)])
  @@index([createdBy])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id          Int      @id @default(autoincrement())
  workspaceId Int      @map("workspace_id")
  invoiceId   Int      @map("invoice_id")
  itemId      Int      @map("item_id")
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(18, 0)
  totalPrice  Decimal  @map("total_price") @db.Decimal(18, 0)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Restrict, not SetNull: an item on a historical invoice shouldn't be
  // deletable, or the invoice total stops being explainable.
  item      Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([invoiceId])
  @@index([itemId])
  @@map("purchase_invoice_items")
}

// ── Sale invoices ────────────────────────────────────────────

model SaleInvoice {
  id            Int      @id @default(autoincrement())
  workspaceId   Int      @map("workspace_id")
  invoiceNumber String   @map("invoice_number")
  customerId    Int?     @map("customer_id")
  // Denormalized copies: they preserve what the invoice said at the time
  // even if the customer record changes later.
  customerName  String?  @map("customer_name")
  customerPhone String?  @map("customer_phone")
  deviceId      Int?     @map("device_id")
  invoiceDate   DateTime @default(now()) @map("invoice_date")
  totalAmount   Decimal  @default(0) @map("total_amount") @db.Decimal(18, 0)
  paidAmount    Decimal  @default(0) @map("paid_amount") @db.Decimal(18, 0)
  paymentStatus String   @default("pending") @map("payment_status")
  note          String?
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  device    Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  author    User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  items SaleInvoiceItem[]

  @@unique([workspaceId, invoiceNumber])
  @@index([workspaceId, invoiceDate(sort: Desc)])
  @@index([workspaceId, paymentStatus])
  @@index([customerId])
  @@index([deviceId])
  @@index([createdBy])
  @@map("sale_invoices")
}

model SaleInvoiceItem {
  id             Int      @id @default(autoincrement())
  workspaceId    Int      @map("workspace_id")
  invoiceId      Int      @map("invoice_id")
  itemId         Int?     @map("item_id")
  name           String?
  unit           String?
  quantity       Int
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 0)
  discountType   String?  @map("discount_type")
  discountValue  Decimal  @default(0) @map("discount_value") @db.Decimal(18, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 0)
  totalPrice     Decimal  @map("total_price") @db.Decimal(18, 0)
  createdAt      DateTime @default(now()) @map("created_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   SaleInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item      Item?       @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([invoiceId])
  @@index([itemId])
  @@map("sale_invoice_items")
}

// ── Services ─────────────────────────────────────────────────

model Service {
  id           Int      @id @default(autoincrement())
  workspaceId  Int      @map("workspace_id")
  name         String
  description  String?
  defaultPrice Decimal  @default(0) @map("default_price") @db.Decimal(18, 0)
  unit         String   @default("خدمت")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive, sortOrder])
  @@map("services")
}

// ── Repair invoices ──────────────────────────────────────────

model RepairInvoice {
  id             Int                 @id @default(autoincrement())
  workspaceId    Int                 @map("workspace_id")
  invoiceNumber  String              @map("invoice_number")
  deviceId       Int                 @map("device_id")
  customerId     Int?                @map("customer_id")
  customerName   String?             @map("customer_name")
  customerPhone  String?             @map("customer_phone")
  invoiceDate    DateTime            @default(now()) @map("invoice_date")
  dueDate        DateTime?           @map("due_date")
  status         RepairInvoiceStatus @default(draft)
  subtotal       Decimal             @default(0) @db.Decimal(18, 0)
  discountType   String?             @map("discount_type")
  discountValue  Decimal             @default(0) @map("discount_value") @db.Decimal(18, 2)
  discountAmount Decimal             @default(0) @map("discount_amount") @db.Decimal(18, 0)
  taxRate        Decimal             @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount      Decimal             @default(0) @map("tax_amount") @db.Decimal(18, 0)
  totalAmount    Decimal             @default(0) @map("total_amount") @db.Decimal(18, 0)
  paidAmount     Decimal             @default(0) @map("paid_amount") @db.Decimal(18, 0)
  paymentStatus  String              @default("pending") @map("payment_status")
  warrantyMonths Int                 @default(0) @map("warranty_months")
  warrantyUntil  DateTime?           @map("warranty_until")
  technicianId   Int?                @map("technician_id")
  notes          String?
  createdBy      Int?                @map("created_by")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Restrict: deviceId is NOT NULL, so an invoice without its device would
  // be meaningless.
  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  technician User?     @relation("RepairInvoiceTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  author     User?     @relation("RepairInvoiceAuthor", fields: [createdBy], references: [id], onDelete: SetNull)

  items    RepairInvoiceItem[]
  payments RepairInvoicePayment[]

  @@unique([workspaceId, invoiceNumber])
  @@index([workspaceId, invoiceDate(sort: Desc)])
  @@index([workspaceId, status])
  @@index([deviceId])
  @@index([customerId])
  @@index([technicianId])
  @@index([createdBy])
  @@map("repair_invoices")
}

model RepairInvoiceItem {
  id             Int      @id @default(autoincrement())
  workspaceId    Int      @map("workspace_id")
  invoiceId      Int      @map("invoice_id")
  itemType       String   @map("item_type")
  // Deliberately NOT a relation: itemType distinguishes parts from services,
  // so this column may point at either items or services.
  itemId         Int?     @map("item_id")
  name           String
  description    String?
  quantity       Decimal  @default(1) @db.Decimal(10, 2)
  unit           String?
  unitPrice      Decimal  @default(0) @map("unit_price") @db.Decimal(18, 0)
  discountType   String?  @map("discount_type")
  discountValue  Decimal  @default(0) @map("discount_value") @db.Decimal(18, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 0)
  totalPrice     Decimal  @default(0) @map("total_price") @db.Decimal(18, 0)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   RepairInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([invoiceId])
  @@map("repair_invoice_items")
}

model RepairInvoicePayment {
  id              Int      @id @default(autoincrement())
  workspaceId     Int      @map("workspace_id")
  invoiceId       Int      @map("invoice_id")
  amount          Decimal  @db.Decimal(18, 0)
  paymentMethod   String   @default("cash") @map("payment_method")
  referenceNumber String?  @map("reference_number")
  note            String?
  paymentDate     DateTime @default(now()) @map("payment_date")
  createdBy       Int?     @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   RepairInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  author    User?         @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([invoiceId])
  @@index([createdBy])
  @@map("repair_invoice_payments")
}

// ── Settings & backups ───────────────────────────────────────

// One row per workspace, enforced by the unique workspaceId — each shop
// controls its own invoice appearance and defaults.
model Settings {
  id                    Int     @id @default(autoincrement())
  workspaceId           Int     @unique @map("workspace_id")
  companyName           String? @map("company_name")
  companyAddress        String? @map("company_address")
  companyPhone          String? @map("company_phone")
  companyEmail          String? @map("company_email")
  companyWebsite        String? @map("company_website")
  companyLogo           String? @map("company_logo")
  stampImage            String? @map("stamp_image")
  signatureImage        String? @map("signature_image")
  defaultTaxRate        Decimal @default(0) @map("default_tax_rate") @db.Decimal(5, 2)
  defaultWarrantyMonths Int     @default(3) @map("default_warranty_months")
  invoicePrefix         String  @default("INV-") @map("invoice_prefix")
  invoiceFooterText     String? @map("invoice_footer_text")

  saleInvoicePaperSize         String  @default("A5") @map("sale_invoice_paper_size")
  saleInvoiceShowLogo          Boolean @default(true) @map("sale_invoice_show_logo")
  saleInvoiceShowCompanyInfo   Boolean @default(true) @map("sale_invoice_show_company_info")
  saleInvoiceShowEmail         Boolean @default(false) @map("sale_invoice_show_email")
  saleInvoiceShowWebsite       Boolean @default(false) @map("sale_invoice_show_website")
  saleInvoiceShowDeviceInfo    Boolean @default(false) @map("sale_invoice_show_device_info")
  saleInvoiceShowCustomerPhone Boolean @default(false) @map("sale_invoice_show_customer_phone")
  saleInvoiceShowDiscount      Boolean @default(false) @map("sale_invoice_show_discount")
  saleInvoiceShowTax           Boolean @default(false) @map("sale_invoice_show_tax")
  saleInvoiceShowStamp         Boolean @default(false) @map("sale_invoice_show_stamp")
  saleInvoiceShowSignature     Boolean @default(false) @map("sale_invoice_show_signature")
  saleInvoiceShowWarranty      Boolean @default(false) @map("sale_invoice_show_warranty")
  saleInvoiceShowTechnician    Boolean @default(false) @map("sale_invoice_show_technician")
  saleInvoiceHeaderText        String? @map("sale_invoice_header_text")
  saleInvoiceFooterText        String? @default("با تشکر از اعتماد شما") @map("sale_invoice_footer_text")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("settings")
}

/// Rows here are per-workspace data exports, not platform backups: durability
/// is a cron on the host (ops/backup-database.sh), deliberately outside the
/// app. The table keeps its old name to avoid a rename migration that buys
/// nothing.
model Backup {
  id              Int      @id @default(autoincrement())
  workspaceId     Int      @map("workspace_id")
  filename        String
  sizeBytes       BigInt   @default(0) @map("size_bytes")
  includesUploads Boolean  @default(false) @map("includes_uploads")
  /// pending until the background build finishes, then ready or failed. A row
  /// left pending means the process died mid-build — recoverable by asking
  /// for another export, and visible rather than silent.
  status          String   @default("pending")
  /// The object key, null until the upload succeeds. Signed per request like
  /// every other object, never stored as a URL.
  filepath        String?
  /// Why it failed, for the operator. Shown to the workshop as a generic
  /// message: the detail is a stack trace, not something a shop owner acts on.
  error           String?
  createdBy       Int?     @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([createdBy])
  @@map("backups")
}
