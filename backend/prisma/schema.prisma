// Modeled on the existing SQLite schema in src/config/database.js — same
// entities and shape, not a redesign (see CLAUDE.md). workspaceId and the
// SaaS fields are deliberately absent: they arrive in phase 2, so the DB
// migration risk stays isolated from the multi-tenancy risk.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceStatus {
  trial
  active
  expired

  @@map("workspace_status")
}

// Enums are used only where the current code proves the value set is closed:
// the CHECK constraint in the old SQLite schema, and the validStatuses array
// in repairInvoiceController. Other status-like columns stay String until
// their controllers are read in task 1.3 — guessing a set here would turn a
// missed value into a runtime failure.

enum InventoryTransactionType {
  purchase
  sale
  adjustment

  @@map("inventory_transaction_type")
}

enum RepairInvoiceStatus {
  draft
  issued
  paid
  cancelled

  @@map("repair_invoice_status")
}

// ── Auth & people ────────────────────────────────────────────

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

model User {
  id        Int      @id @default(autoincrement())
  fullName  String   @map("full_name")
  username  String   @unique
  password  String
  phone     String?
  avatar    String?
  roleId    Int      @map("role_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  devicesAssigned        Device[]               @relation("DeviceTechnician")
  assignmentsReceived    DeviceAssignment[]     @relation("AssignmentTechnician")
  assignmentsMade        DeviceAssignment[]     @relation("AssignmentAuthor")
  inventoryTransactions  InventoryTransaction[]
  purchaseInvoices       PurchaseInvoice[]
  saleInvoices           SaleInvoice[]
  repairInvoicesCreated  RepairInvoice[]        @relation("RepairInvoiceAuthor")
  repairInvoicesAssigned RepairInvoice[]        @relation("RepairInvoiceTechnician")
  repairInvoicePayments  RepairInvoicePayment[]
  backups                Backup[]

  @@index([roleId])
  @@map("users")
}

// ── Customers & devices ──────────────────────────────────────

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")

  devices        Device[]
  saleInvoices   SaleInvoice[]
  repairInvoices RepairInvoice[]

  @@index([phone])
  @@map("customers")
}

model Device {
  id           Int       @id @default(autoincrement())
  customerId   Int?      @map("customer_id")
  personnelId  Int?      @map("personnel_id")
  deviceName   String    @map("device_name")
  brand        String?
  model        String?
  serialNumber String?   @map("serial_number")
  entryDate    DateTime? @map("entry_date")
  exitDate     DateTime? @map("exit_date")
  status       String    @default("received")
  description  String?
  needsInvoice Boolean   @default(true) @map("needs_invoice")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // SetNull rather than Cascade: a repair history should survive deleting
  // the customer or the technician who handled it.
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  personnel User?     @relation("DeviceTechnician", fields: [personnelId], references: [id], onDelete: SetNull)

  images         DeviceImage[]
  assignments    DeviceAssignment[]
  repairInvoices RepairInvoice[]
  saleInvoices   SaleInvoice[]

  @@index([customerId])
  @@index([personnelId])
  @@index([status])
  @@map("devices")
}

model DeviceImage {
  id        Int      @id @default(autoincrement())
  deviceId  Int      @map("device_id")
  filename  String
  filepath  String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("device_images")
}

model DeviceAssignment {
  id          Int      @id @default(autoincrement())
  deviceId    Int      @map("device_id")
  personnelId Int      @map("personnel_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")
  assignedBy  Int?     @map("assigned_by")

  device    Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  personnel User   @relation("AssignmentTechnician", fields: [personnelId], references: [id], onDelete: Cascade)
  author    User?  @relation("AssignmentAuthor", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([deviceId, personnelId])
  @@index([personnelId])
  @@map("device_assignments")
}

// ── Inventory ────────────────────────────────────────────────

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items Item[]

  @@map("categories")
}

model Item {
  id               Int      @id @default(autoincrement())
  categoryId       Int?     @map("category_id")
  name             String
  code             String?  @unique
  unit             String   @default("عدد")
  minStock         Int      @default(0) @map("min_stock")
  currentStock     Int      @default(0) @map("current_stock")
  // Rial amounts are whole numbers, but an average is not — hence 2 decimals
  // here while the plain price/total columns stay at 0.
  avgPurchasePrice Decimal  @default(0) @map("avg_purchase_price") @db.Decimal(18, 2)
  sellPrice        Decimal  @default(0) @map("sell_price") @db.Decimal(18, 0)
  description      String?
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  transactions         InventoryTransaction[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  saleInvoiceItems     SaleInvoiceItem[]

  @@index([categoryId])
  @@index([name])
  @@map("items")
}

model InventoryTransaction {
  id            Int                      @id @default(autoincrement())
  itemId        Int                      @map("item_id")
  // Preserves the CHECK constraint the SQLite schema already enforced.
  type          InventoryTransactionType
  quantity      Int
  unitPrice     Decimal                  @default(0) @map("unit_price") @db.Decimal(18, 0)
  // Polymorphic pointer (reference_type says which table). No FK in SQLite
  // either, so it stays a bare column rather than a broken relation.
  referenceId   Int?                     @map("reference_id")
  referenceType String?                  @map("reference_type")
  note          String?
  createdBy     Int?                     @map("created_by")
  createdAt     DateTime                 @default(now()) @map("created_at")

  item   Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([createdBy])
  @@map("inventory_transactions")
}

// ── Purchase invoices ────────────────────────────────────────

model PurchaseInvoice {
  id            Int      @id @default(autoincrement())
  invoiceNumber String   @unique @map("invoice_number")
  supplierName  String?  @map("supplier_name")
  invoiceDate   DateTime @default(now()) @map("invoice_date")
  totalAmount   Decimal  @default(0) @map("total_amount") @db.Decimal(18, 0)
  paidAmount    Decimal  @default(0) @map("paid_amount") @db.Decimal(18, 0)
  paymentStatus String   @default("pending") @map("payment_status")
  note          String?
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  author User?                 @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  items  PurchaseInvoiceItem[]

  @@index([invoiceDate])
  @@index([createdBy])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id         Int      @id @default(autoincrement())
  invoiceId  Int      @map("invoice_id")
  itemId     Int      @map("item_id")
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(18, 0)
  totalPrice Decimal  @map("total_price") @db.Decimal(18, 0)
  createdAt  DateTime @default(now()) @map("created_at")

  invoice PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Restrict, not SetNull: an item that appears on a historical invoice
  // shouldn't be deletable, or the invoice total stops being explainable.
  item    Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([itemId])
  @@map("purchase_invoice_items")
}

// ── Sale invoices ────────────────────────────────────────────

model SaleInvoice {
  id            Int      @id @default(autoincrement())
  invoiceNumber String   @unique @map("invoice_number")
  customerId    Int?     @map("customer_id")
  // Denormalized copies kept from the current schema: they preserve what the
  // invoice said at the time even if the customer record changes later.
  customerName  String?  @map("customer_name")
  customerPhone String?  @map("customer_phone")
  deviceId      Int?     @map("device_id")
  invoiceDate   DateTime @default(now()) @map("invoice_date")
  totalAmount   Decimal  @default(0) @map("total_amount") @db.Decimal(18, 0)
  paidAmount    Decimal  @default(0) @map("paid_amount") @db.Decimal(18, 0)
  paymentStatus String   @default("pending") @map("payment_status")
  note          String?
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // device_id was added by a bare ALTER TABLE with no FK; promoted to a real
  // relation here.
  device   Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  author   User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  items SaleInvoiceItem[]

  @@index([invoiceDate])
  @@index([customerId])
  @@index([deviceId])
  @@index([createdBy])
  @@map("sale_invoices")
}

model SaleInvoiceItem {
  id             Int      @id @default(autoincrement())
  invoiceId      Int      @map("invoice_id")
  itemId         Int?     @map("item_id")
  name           String?
  unit           String?
  quantity       Int
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 0)
  discountType   String?  @map("discount_type")
  // Holds either a percentage or a rial amount depending on discountType,
  // so it needs the wider precision of an amount rather than a rate.
  discountValue  Decimal  @default(0) @map("discount_value") @db.Decimal(18, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 0)
  totalPrice     Decimal  @map("total_price") @db.Decimal(18, 0)
  createdAt      DateTime @default(now()) @map("created_at")

  invoice SaleInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    Item?       @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([itemId])
  @@map("sale_invoice_items")
}

// ── Services ─────────────────────────────────────────────────

// This table was created lazily at runtime by serviceController.js, which
// also seeded four default rows. Declared properly here; the seeding moves
// to a seed script in task 1.3.
model Service {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  defaultPrice Decimal  @default(0) @map("default_price") @db.Decimal(18, 0)
  unit         String   @default("خدمت")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("services")
}

// ── Repair invoices ──────────────────────────────────────────

model RepairInvoice {
  id             Int                 @id @default(autoincrement())
  invoiceNumber  String              @unique @map("invoice_number")
  deviceId       Int                 @map("device_id")
  customerId     Int?                @map("customer_id")
  customerName   String?             @map("customer_name")
  customerPhone  String?             @map("customer_phone")
  invoiceDate    DateTime            @default(now()) @map("invoice_date")
  dueDate        DateTime?           @map("due_date")
  status         RepairInvoiceStatus @default(draft)
  subtotal       Decimal             @default(0) @db.Decimal(18, 0)
  discountType   String?             @map("discount_type")
  discountValue  Decimal             @default(0) @map("discount_value") @db.Decimal(18, 2)
  discountAmount Decimal             @default(0) @map("discount_amount") @db.Decimal(18, 0)
  taxRate        Decimal             @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount      Decimal             @default(0) @map("tax_amount") @db.Decimal(18, 0)
  totalAmount    Decimal             @default(0) @map("total_amount") @db.Decimal(18, 0)
  paidAmount     Decimal             @default(0) @map("paid_amount") @db.Decimal(18, 0)
  paymentStatus  String              @default("pending") @map("payment_status")
  warrantyMonths Int                 @default(0) @map("warranty_months")
  warrantyUntil  DateTime?           @map("warranty_until")
  technicianId   Int?                @map("technician_id")
  notes          String?
  createdBy      Int?                @map("created_by")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  // Restrict: device_id is NOT NULL, so a repair invoice without its device
  // would be meaningless.
  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  technician User?     @relation("RepairInvoiceTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  author     User?     @relation("RepairInvoiceAuthor", fields: [createdBy], references: [id], onDelete: SetNull)

  items    RepairInvoiceItem[]
  payments RepairInvoicePayment[]

  @@index([deviceId])
  @@index([status])
  @@index([invoiceDate])
  @@index([customerId])
  @@index([technicianId])
  @@index([createdBy])
  @@map("repair_invoices")
}

model RepairInvoiceItem {
  id             Int      @id @default(autoincrement())
  invoiceId      Int      @map("invoice_id")
  itemType       String   @map("item_type")
  // Deliberately NOT a relation: repairInvoiceController only resolves
  // item_id against the items table when item_type === "inventory"; for
  // other types it stores whatever id the client sent, which for services
  // points at the services table. SQLite declared an FK here but never
  // enforced it (the foreign_keys pragma is off), so Postgres would reject
  // inserts that work today.
  itemId         Int?     @map("item_id")
  name           String
  description    String?
  quantity       Decimal  @default(1) @db.Decimal(10, 2)
  unit           String?
  unitPrice      Decimal  @default(0) @map("unit_price") @db.Decimal(18, 0)
  discountType   String?  @map("discount_type")
  discountValue  Decimal  @default(0) @map("discount_value") @db.Decimal(18, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 0)
  totalPrice     Decimal  @default(0) @map("total_price") @db.Decimal(18, 0)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  invoice RepairInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("repair_invoice_items")
}

model RepairInvoicePayment {
  id              Int      @id @default(autoincrement())
  invoiceId       Int      @map("invoice_id")
  amount          Decimal  @db.Decimal(18, 0)
  paymentMethod   String   @default("cash") @map("payment_method")
  referenceNumber String?  @map("reference_number")
  note            String?
  paymentDate     DateTime @default(now()) @map("payment_date")
  createdBy       Int?     @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  invoice RepairInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  author  User?         @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([createdBy])
  @@map("repair_invoice_payments")
}

// ── Settings & backups ───────────────────────────────────────

// Single-row table (id = 1) today. Becomes one row per workspace in phase 2.
model Settings {
  id                    Int     @id @default(autoincrement())
  companyName           String? @map("company_name")
  companyAddress        String? @map("company_address")
  companyPhone          String? @map("company_phone")
  companyEmail          String? @map("company_email")
  companyWebsite        String? @map("company_website")
  companyLogo           String? @map("company_logo")
  stampImage            String? @map("stamp_image")
  signatureImage        String? @map("signature_image")
  defaultTaxRate        Decimal @default(0) @map("default_tax_rate") @db.Decimal(5, 2)
  defaultWarrantyMonths Int     @default(3) @map("default_warranty_months")
  invoicePrefix         String  @default("INV-") @map("invoice_prefix")
  invoiceFooterText     String? @map("invoice_footer_text")

  saleInvoicePaperSize         String  @default("A5") @map("sale_invoice_paper_size")
  saleInvoiceShowLogo          Boolean @default(true) @map("sale_invoice_show_logo")
  saleInvoiceShowCompanyInfo   Boolean @default(true) @map("sale_invoice_show_company_info")
  saleInvoiceShowEmail         Boolean @default(false) @map("sale_invoice_show_email")
  saleInvoiceShowWebsite       Boolean @default(false) @map("sale_invoice_show_website")
  saleInvoiceShowDeviceInfo    Boolean @default(false) @map("sale_invoice_show_device_info")
  saleInvoiceShowCustomerPhone Boolean @default(false) @map("sale_invoice_show_customer_phone")
  saleInvoiceShowDiscount      Boolean @default(false) @map("sale_invoice_show_discount")
  saleInvoiceShowTax           Boolean @default(false) @map("sale_invoice_show_tax")
  saleInvoiceShowStamp         Boolean @default(false) @map("sale_invoice_show_stamp")
  saleInvoiceShowSignature     Boolean @default(false) @map("sale_invoice_show_signature")
  saleInvoiceShowWarranty      Boolean @default(false) @map("sale_invoice_show_warranty")
  saleInvoiceShowTechnician    Boolean @default(false) @map("sale_invoice_show_technician")
  saleInvoiceHeaderText        String? @map("sale_invoice_header_text")
  saleInvoiceFooterText        String? @default("با تشکر از اعتماد شما") @map("sale_invoice_footer_text")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Backup {
  id              Int      @id @default(autoincrement())
  filename        String
  sizeBytes       BigInt   @default(0) @map("size_bytes")
  includesUploads Boolean  @default(false) @map("includes_uploads")
  createdBy       Int?     @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  author User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([createdBy])
  @@map("backups")
}

// ── Tenancy ──────────────────────────────────────────────────

// A repair shop. Nothing references it yet — task 2.2 adds workspaceId to
// the tenant-scoped tables.
//
// No slug: the app is served from one shared domain, so a workspace is only
// ever identified by the id carried in the caller's token. A URL-safe name
// would have nothing to do.
model Workspace {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Subscription state. Plans differ only in price and duration, so the plan
  // itself lives on the Subscription record added in phase 8 — what matters
  // here is whether the workspace may currently be written to.
  status    WorkspaceStatus @default(trial)
  // Both the trial and a paid period end here; whichever is current.
  expiresAt DateTime?       @map("expires_at")

  @@index([status])
  @@map("workspaces")
}
