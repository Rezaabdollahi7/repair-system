# Configuration for ops/backup-database.sh. Copy to ops/backup.env:
#
#   cp ops/backup.env.example ops/backup.env
#
# Deliberately separate from backend/.env: a backup must not depend on the
# application's own configuration, since that file is one of the things that
# may have been damaged by whatever made the backup necessary.

# Where the production compose file lives. Not derived from this script's
# location: on the server there is no repository, only the compose file and
# the script side by side, and the file is not named docker-compose.yml.
COMPOSE_DIR=/home/reza/dofixo
COMPOSE_FILE=docker-compose.prod.yml
COMPOSE_ENV_FILE=.env.prod

# The compose service and database to dump. pg_dump runs inside the container,
# so no postgresql-client is needed on the host and the client version always
# matches the server.
POSTGRES_SERVICE=postgres
POSTGRES_USER=dofixo
POSTGRES_DB=dofixo_dev

# The public half of the age key pair. Harmless if it leaks — it can only
# encrypt. The private key must never be on this machine: a server that has
# been broken into should not be able to read its own old backups.
#
# ⚠️ Losing the private key makes every backup permanently unreadable. Keep
# two copies, in two physical places.
AGE_PUBLIC_KEY=age1q5hedz4n5tjqw7r3n5z6rdvm4mf6qkshz26djzm4khmageu8xaqqejr2yk

# ArvanCloud. Production uses dofixo-prod; a development checkout points at
# its own bucket so a test run never touches real backups.
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_BUCKET=reza-app-test-1
S3_PREFIX=backups/dev
S3_ACCESS_KEY=
S3_SECRET_KEY=

#   0 3 * * * cd /home/reza/dofixo && ./backup-database.sh >> /home/reza/dofixo-backup.log 2>&1
#
# ⚠️ Not /var/log: the unprivileged user cron runs as cannot write there, and
# the failure is silent — which is the one thing a backup must never be.
#
# The log matters: a backup that has been failing silently for a month is
# worse than no backup, because you think you have one.